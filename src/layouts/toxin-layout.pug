doctype html 
html 
    head
        block default-scripts
            link(href=require('../index.scss') rel='stylesheet')
            meta(name="viewport" content="width=device-width")
        block scripts
        block default-values
            script
                - let arr1 = ["Навигация","О нас", "Новости", "Служба поддержки", "Услуги"]
                - let arr2 = ["О нас","О сервисе","Наша команда","Вакансии","Инвесторы"]
                - let arr3 = ["Служба поддержки","Соглашения","Сообщества","Связь с нами"]
                - let arr4 = ["Подписка","Получайте специальные предложения и новости сервиса"]
        block values
    body
        block header 
            .layout-header
                +header-logged-out()   
        block content
        block footer
            .layout-footer 
                +footer(arr1,arr2,arr3,arr4)
        block default js
            script 
                include ../components/header-logged-out/header-logged-out.js 
        block js
            