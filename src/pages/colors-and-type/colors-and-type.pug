extends ../../layouts/ui-kit-layout.pug
include ../../components/colors/colors.pug
include ../../components/typography/typography.pug
include ../../components/ui-logo/ui-logo.pug
block scripts 
    link(href=require('./colors-and-type.scss') rel='stylesheet')
    link(href=require('../../components/colors/colors.scss') rel='stylesheet')
block content 
    .colors
        .colors__logo-container
            +ui-logo()
        .colors__inner
            .colors__left-column
                +colors("#1F2041", "Dark Shade 100%", "#1F2041")
                +colors("#1F2041BF", "Dark Shade 75%", "#1F2041")
                +colors("#1F20417F", "Dark Shade 50%", "#1F2041")
                +colors("#1F20413F", "Dark Shade 25%", "#1F2041")
                +colors("#1F20410D", "Dark Shade 5%", "#1F2041")
                +colors("#BC9CFF", "Purple", "#BC9CFF")
                +colors("#6FCF97", "Green", "#6FCF97")
            .colors__right-column
                +typography